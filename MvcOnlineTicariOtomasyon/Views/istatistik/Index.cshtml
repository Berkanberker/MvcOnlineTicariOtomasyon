@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .dashboard-container {
        padding: 20px 0;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h2 {
        color: #2d3436;
        font-weight: 700;
        font-size: 1.8rem;
        margin-bottom: 5px;
    }

    .dashboard-header p {
        color: #636e72;
        font-size: 0.95rem;
    }

    /* Stat Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
    }

    .stat-card.primary::before { background: linear-gradient(135deg, #667eea, #764ba2); }
    .stat-card.success::before { background: linear-gradient(135deg, #00b894, #00cec9); }
    .stat-card.warning::before { background: linear-gradient(135deg, #fdcb6e, #e17055); }
    .stat-card.danger::before { background: linear-gradient(135deg, #fd79a8, #e84393); }
    .stat-card.info::before { background: linear-gradient(135deg, #74b9ff, #0984e3); }
    .stat-card.dark::before { background: linear-gradient(135deg, #636e72, #2d3436); }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 20px;
        color: #fff;
    }

    .stat-card.primary .stat-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
    .stat-card.success .stat-icon { background: linear-gradient(135deg, #00b894, #00cec9); }
    .stat-card.warning .stat-icon { background: linear-gradient(135deg, #fdcb6e, #e17055); }
    .stat-card.danger .stat-icon { background: linear-gradient(135deg, #fd79a8, #e84393); }
    .stat-card.info .stat-icon { background: linear-gradient(135deg, #74b9ff, #0984e3); }
    .stat-card.dark .stat-icon { background: linear-gradient(135deg, #636e72, #2d3436); }

    .stat-content h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2d3436;
        margin-bottom: 5px;
    }

    .stat-content p {
        color: #636e72;
        font-size: 0.9rem;
        margin: 0;
    }

    /* Cards Row */
    .cards-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .dashboard-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2d3436;
        margin: 0;
    }

    .card-header .badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-success { background: rgba(0, 184, 148, 0.1); color: #00b894; }
    .badge-warning { background: rgba(253, 203, 110, 0.2); color: #e17055; }

    .card-body {
        padding: 25px;
    }

    /* Info List */
    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .info-list li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f5f5f5;
    }

    .info-list li:last-child {
        border-bottom: none;
    }

    .info-list .label {
        display: flex;
        align-items: center;
        color: #636e72;
    }

    .info-list .label i {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 0.8rem;
        color: #636e72;
    }

    .info-list .value {
        font-weight: 600;
        color: #2d3436;
    }

    /* Chart Placeholder */
    .chart-container {
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
        color: #636e72;
    }

    /* Quick Actions */
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .action-btn {
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: #f8f9fa;
        color: #2d3436;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .action-btn i {
        font-size: 1.2rem;
        color: #667eea;
    }

    .action-btn:hover {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        transform: translateY(-2px);
    }

    .action-btn:hover i {
        color: #fff;
    }

    /* Today Stats */
    .today-highlight {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 30px;
        border-radius: 16px;
        text-align: center;
    }

    .today-highlight h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .today-highlight p {
        opacity: 0.9;
        font-size: 0.95rem;
    }

    .today-stats {
        display: flex;
        justify-content: space-around;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .today-stat {
        text-align: center;
    }

    .today-stat h4 {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .today-stat span {
        font-size: 0.85rem;
        opacity: 0.8;
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="dashboard-container">
    <div class="dashboard-header">
        <h2><i class="fas fa-chart-pie"></i> Dashboard</h2>
        <p>Hoş geldiniz! İşte genel iş durumunuz.</p>
    </div>

    <!-- Main Stats -->
    <div class="stats-grid">
        <div class="stat-card primary">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d1</h3>
                <p>Toplam Cari</p>
            </div>
        </div>
        <div class="stat-card success">
            <div class="stat-icon"><i class="fas fa-box"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d2</h3>
                <p>Ürün Sayısı</p>
            </div>
        </div>
        <div class="stat-card warning">
            <div class="stat-icon"><i class="fas fa-user-tie"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d3</h3>
                <p>Personel Sayısı</p>
            </div>
        </div>
        <div class="stat-card danger">
            <div class="stat-icon"><i class="fas fa-tags"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d4</h3>
                <p>Kategori Sayısı</p>
            </div>
        </div>
    </div>

    <!-- Second Stats Row -->
    <div class="stats-grid">
        <div class="stat-card info">
            <div class="stat-icon"><i class="fas fa-cubes"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d5</h3>
                <p>Toplam Stok</p>
            </div>
        </div>
        <div class="stat-card dark">
            <div class="stat-icon"><i class="fas fa-copyright"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d6</h3>
                <p>Marka Sayısı</p>
            </div>
        </div>
        <div class="stat-card danger">
            <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d7</h3>
                <p>Kritik Stok</p>
            </div>
        </div>
        <div class="stat-card success">
            <div class="stat-icon"><i class="fas fa-trophy"></i></div>
            <div class="stat-content">
                <h3>@ViewBag.d13</h3>
                <p>En Çok Satan</p>
            </div>
        </div>
    </div>

    <!-- Cards Row -->
    <div class="cards-row">
        <!-- Today's Summary -->
        <div class="dashboard-card">
            <div class="today-highlight">
                <h2>₺@ViewBag.d14</h2>
                <p>Toplam Ciro</p>
                <div class="today-stats">
                    <div class="today-stat">
                        <h4>@ViewBag.d15</h4>
                        <span>Bugünkü Satış</span>
                    </div>
                    <div class="today-stat">
                        <h4>₺@ViewBag.d16</h4>
                        <span>Bugünkü Kasa</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="dashboard-card">
            <div class="card-header">
                <h4><i class="fas fa-chart-bar"></i> Ürün İstatistikleri</h4>
                <span class="badge badge-success">Güncel</span>
            </div>
            <div class="card-body">
                <ul class="info-list">
                    <li>
                        <span class="label"><i class="fas fa-arrow-up"></i> En Pahalı Ürün</span>
                        <span class="value">@ViewBag.d8</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-arrow-down"></i> En Ucuz Ürün</span>
                        <span class="value">@ViewBag.d9</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-star"></i> En Popüler Marka</span>
                        <span class="value">@ViewBag.d12</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-snowflake"></i> Buzdolabı Sayısı</span>
                        <span class="value">@ViewBag.d10</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-laptop"></i> Laptop Sayısı</span>
                        <span class="value">@ViewBag.d11</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="dashboard-card">
            <div class="card-header">
                <h4><i class="fas fa-bolt"></i> Hızlı İşlemler</h4>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a href="/Satis/YeniSatis" class="action-btn">
                        <i class="fas fa-shopping-cart"></i>
                        Yeni Satış
                    </a>
                    <a href="/Urun/YeniUrun" class="action-btn">
                        <i class="fas fa-plus-circle"></i>
                        Ürün Ekle
                    </a>
                    <a href="/Cari/YeniCari" class="action-btn">
                        <i class="fas fa-user-plus"></i>
                        Cari Ekle
                    </a>
                    <a href="/Fatura/FaturaEkle" class="action-btn">
                        <i class="fas fa-file-invoice"></i>
                        Fatura Oluştur
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
