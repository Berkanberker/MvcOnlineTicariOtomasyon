@using MvcOnlineTicariOtomasyon.Models.NewFolder1.siniflar
@model List<Urun>

@{
    ViewBag.Title = "Ürünler";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="fas fa-box text-primary"></i> Ürün Yönetimi</h2>
            <p>Tüm ürünlerinizi buradan yönetebilirsiniz</p>
        </div>
        <a href="/Urun/YeniUrun/" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Yeni Ürün Ekle
        </a>
    </div>
</div>

<!-- Products Card -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list"></i> Ürün Listesi</span>
        <span class="badge badge-primary">@Model.Count ürün</span>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <h4>Henüz ürün eklenmemiş</h4>
                <p>Yeni bir ürün ekleyerek başlayın</p>
                <a href="/Urun/YeniUrun/" class="btn btn-primary mt-3">
                    <i class="fas fa-plus"></i> İlk Ürünü Ekle
                </a>
            </div>
        }
        else
        {
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Marka</th>
                        <th>Stok</th>
                        <th>Alış Fiyatı</th>
                        <th>Satış Fiyatı</th>
                        <th>Kategori</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <strong>@u.UrunAd</strong>
                            </td>
                            <td>
                                <span class="badge badge-secondary">@u.Marka</span>
                            </td>
                            <td>
                                @if (u.Stok <= 10)
                                {
                                    <span class="badge badge-danger">
                                        <i class="fas fa-exclamation-triangle"></i> @u.Stok
                                    </span>
                                }
                                else if (u.Stok <= 50)
                                {
                                    <span class="badge badge-warning">@u.Stok</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">@u.Stok</span>
                                }
                            </td>
                            <td>₺@String.Format("{0:N2}", u.AlisFiyat)</td>
                            <td><strong>₺@String.Format("{0:N2}", u.SatisFiyat)</strong></td>
                            <td>
                                <span class="badge badge-info">
                                    @(u.Kategori != null ? u.Kategori.KategoriAd : "-")
                                </span>
                            </td>
                            <td>
                                <div class="action-btns justify-content-center">
                                    <a href="/Urun/SatisYap/@u.Urunid" class="btn btn-sm btn-primary" title="Satış Yap">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                    <a href="/Urun/UrunGetir/@u.Urunid" class="btn btn-sm btn-success" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" 
                                            onclick="confirmDelete('/Urun/UrunSil/@u.Urunid', '@u.UrunAd')" 
                                            title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            // DataTable already initialized in layout
        });
    </script>
}
